# Copy to .env and provide your own TMDB Read Access Token.
# The backend launcher reads .env without printing values. Never commit .env.
TMDB_READ_ACCESS_TOKEN=
REELVAULT_CORS_ORIGINS=http://localhost:3000
REELVAULT_COOKIE_SECURE=false
REELVAULT_DATABASE_URL=jdbc:sqlite:./data/reelvault.db
REELVAULT_DATABASE_DRIVER=org.sqlite.JDBC
REELVAULT_HIBERNATE_DIALECT=org.hibernate.community.dialect.SQLiteDialect
